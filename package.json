{
  "name": "shuacrew",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @shuacrew/gateway dev",
    "build": "pnpm -r --filter ./packages/** --filter ./apps/** build",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "pnpm -r --parallel exec tsc --noEmit -p .",
    "lint": "eslint .",
    "demo": "pnpm --filter @shuacrew/gateway demo",
    "eval": "tsx scripts/eval.ts",
    "service": "sh scripts/service.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
